DATABASE_HOST=your-postgresql-host
DATABASE_PORT=5432
DATABASE_NAME=contoso
DATABASE_USER=workshop_reader
DATABASE_PASSWORD=replace-with-instructor-password
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# For IBM Cloud's private CA, place its PEM certificate beside this file.
DATABASE_CA_FILE=database-ca.pem
# Demo-only single-file setup: set DATABASE_SSL_REJECT_UNAUTHORIZED=false
# and remove DATABASE_CA_FILE. TLS stays on, but server identity is NOT verified.
